{
  "name": "ai-session-bridge",
  "version": "0.3.0",
  "description": "Bridge your AI coding sessions between OpenAI Codex CLI and Anthropic Claude Code CLI. Convert JSONL sessions bidirectionally and continue where you left off.",
  "type": "module",
  "bin": {
    "ai-session-bridge": "./src/cli.ts"
  },
  "scripts": {
    "bridge": "tsx src/cli.ts",
    "list": "tsx src/cli.ts list",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codex",
    "claude",
    "claude-code",
    "openai",
    "anthropic",
    "session",
    "bridge",
    "converter",
    "cli",
    "ai-coding",
    "jsonl",
    "codex-cli",
    "claude-code-cli",
    "claude2codex",
    "codex2claude",
    "claude-codex-bridge",
    "session-converter",
    "resume-session"
  ],
  "author": "Bakhtier Sizhaev",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "homepage": "https://bakhtiersizhaev.github.io/ai-session-bridge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakhtiersizhaev/ai-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/bakhtiersizhaev/ai-session-bridge/issues"
  }
}
